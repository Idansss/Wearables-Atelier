# ═══════════════════════════════════════════════════════════════
# Wearables Atelier — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# SETUP:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in ALL values below
#   3. NEVER commit .env to git (it is already in .gitignore)
#
# All variables prefixed with VITE_ are bundled into the frontend
# build and are visible to end users in the browser. Never put
# secrets (Resend, service keys, etc.) in VITE_ variables.
#
# Secrets must only be set in Supabase's secret store:
#   Dashboard → Edge Functions → Manage secrets
#   OR: supabase secrets set KEY=value
# ───────────────────────────────────────────────────────────────


# ── Supabase ──────────────────────────────────────────────────
# Find at: https://supabase.com/dashboard → Project Settings → API

# Your Supabase project URL (safe to expose — used in frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (safe to expose — RLS enforces access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── Paystack ──────────────────────────────────────────────────
# Get at: https://dashboard.paystack.com/#/settings/developer
# Use pk_test_... for development, pk_live_... for production

VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here


# ══════════════════════════════════════════════════════════════
# ⚠  SECRETS — SERVER-SIDE ONLY (Supabase Edge Functions)
# ══════════════════════════════════════════════════════════════
#
# The Resend API key MUST only be set as a Supabase secret.
# NEVER create VITE_RESEND_API_KEY — it would be exposed to all users.
#
# Set in production (run once):
#   supabase secrets set RESEND_API_KEY=re_your_key_here \
#     --project-ref your-project-ref
#
# For local Edge Function development only (supabase functions serve):
#   Create supabase/.env.local:
#   RESEND_API_KEY=re_your_key_here
#
# ══════════════════════════════════════════════════════════════
# GITHUB ACTIONS SECRETS (repo Settings → Secrets and variables)
# ══════════════════════════════════════════════════════════════
#
# Required for the CI/CD pipeline (.github/workflows/ci.yml):
#
#   VITE_SUPABASE_URL           — same as above
#   VITE_SUPABASE_ANON_KEY      — same as above
#   VITE_PAYSTACK_PUBLIC_KEY    — live key for production
#   SUPABASE_ACCESS_TOKEN       — from supabase.com/dashboard/account/tokens
#   SUPABASE_PROJECT_ID         — your project reference ID (e.g. abcdefghijklmno)
