rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    // Products are public; only admins can modify.
    match /products/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: anyone can place, admins can view/update.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Custom orders: anyone can request, admins can view/update.
    match /custom_orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Newsletter subscribers: anyone can subscribe; admins can moderate.
    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: anyone can send; admins can read/update.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Wholesale leads: anyone can submit; admins can read/update.
    match /wholesale_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin user docs: users can read their own doc; admins can manage.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if isAdmin();
    }

    // Coupons are public-but-limited: active + not expired + under maxUses.
    // Admins can always read/write.
    match /coupons/{couponId} {
      allow read: if isAdmin()
        || (
          resource.data.active == true
          && (resource.data.expiresAt == null || resource.data.expiresAt > request.time)
          && (resource.data.maxUses == null || resource.data.usedCount < resource.data.maxUses)
        );

      allow create, update, delete: if isAdmin();
    }

    // Site settings doc (used by AnnouncementBar content CMS).
    match /settings/{docId} {
      allow read: if docId == 'site';
      allow create, update, delete: if isAdmin();
    }

    // Admin audit logs.
    match /audit_logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}

